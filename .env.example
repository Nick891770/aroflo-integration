# AroFlo API (Site Admin > Settings > General > AroFlo API: pre-encoded values)
AROFLO_ORG_NAME=your_org_encoded
AROFLO_USERNAME=your_username_encoded
AROFLO_PASSWORD=your_password_encoded
AROFLO_SECRET_KEY=your_secret_key
AROFLO_HOST_IP=

# Reporting
PRIMARY_CLIENT=           # main client name, for revenue-concentration metrics
LABOUR_ONLY_CLIENTS=      # comma-separated clients whose $0-materials invoices are normal

# Telegram summaries (bill review, PO report, materials recon)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SECRETS_FILE=    # optional: shared env file to read the bot token from
MARKUP_TARGET=0.35      # target material markup (for the low-markup check)
MARKUP_FLOOR=0.20
